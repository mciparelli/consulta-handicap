{
  "private": true,
  "name": "consulta-handicap",
  "description": "consulta de handicap",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "bun build src/index.tsx --outdir=dist --target=browser --minify",
    "build:css": "tailwindcss -i ./src/styles.css -o ./public/styles.css --minify",
    "deploy": "bun run build:css && wrangler deploy",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elysiajs/html": "^1.1.1",
    "@kitajs/html": "^4.2.5",
    "@libsql/client": "^0.14.0",
    "cheerio": "^1.0.0",
    "elysia": "^1.1.26"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "bun-types": "^1.1.34",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "wrangler": "^4.59.1"
  }
}
