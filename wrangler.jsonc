{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "consulta-handicap",
  "main": "src/index.tsx",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
  },
  // Development environment
  "dev": {
    "port": 8787,
  },
  "vars": {
    "DEV": "true",
  },
  "env": {
    "production": {
      "name": "consulta-handicap",
      "vars": {
        "DEV": "false",
      },
    },
  },
}
